-- 5. ANIMATIONS (STARTUP & TOGGLE)
---------------------------------------------------------
local function playStartupAnimation()
    local dot = Instance.new("Frame")
    dot.Name = "IntroDot"
    dot.Parent = ScreenGui
    dot.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    dot.Position = UDim2.new(0.5, -5, 0.5, -5)
    dot.Size = UDim2.new(0, 10, 0, 10)
    dot.AnchorPoint = Vector2.new(0.5, 0.5)

    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = dot

    local boltIcon = Instance.new("TextLabel")
    boltIcon.Parent = dot
    boltIcon.BackgroundTransparency = 1
    boltIcon.Size = UDim2.new(1, 0, 1, 0)
    boltIcon.Font = Enum.Font.GothamBlack
    boltIcon.Text = "⚡"
    boltIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
    boltIcon.TextSize = 1

    local t1 = TweenService:Create(dot, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 90, 0, 90)
    })
    local t1_text = TweenService:Create(boltIcon, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        TextSize = 45,
        Rotation = -25
    })
    
    t1:Play()
    t1_text:Play()
    t1.Completed:Wait()
    task.wait(0.2)

    local t2 = TweenService:Create(dot, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    })
    t2:Play()
    t2.Completed:Wait()
    dot:Destroy()

    MainFrame.Position = lastMainFramePos
    MainFrame.Size = UDim2.new(0, 480, 0, 330)
    MainFrame.BackgroundTransparency = 0
    MainFrame.Visible = true
end

local function closeToToggleAnim()
    lastMainFramePos = MainFrame.Position
    
    local animDot = Instance.new("Frame")
    animDot.Parent = ScreenGui
    animDot.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    animDot.Position = lastMainFramePos + UDim2.new(0, 240, 0, 165)
    animDot.Size = UDim2.new(0, 480, 0, 330)
    animDot.AnchorPoint = Vector2.new(0.5, 0.5)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = animDot

    MainFrame.Visible = false

    local shrink = TweenService:Create(animDot, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 20, 0, 20)
    })
    local roundCorner = TweenService:Create(corner, TweenInfo.new(0.15), {
        CornerRadius = UDim.new(1, 0)
    })
    
    shrink:Play()
    roundCorner:Play()
    shrink.Completed:Wait()

    local move = TweenService:Create(animDot, TweenInfo.new(0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
        Position = OpenToggleBtn.Position + UDim2.new(0, 20, 0, 20)
    })
    move:Play()
    move.Completed:Wait()

    animDot:Destroy()
    OpenToggleBtn.Visible = true
end

local function openFromToggleAnim()
    lastTogglePos = OpenToggleBtn.Position
    OpenToggleBtn.Visible = false

    local animDot = Instance.new("Frame")
    animDot.Parent = ScreenGui
    animDot.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    animDot.Position = lastTogglePos + UDim2.new(0, 20, 0, 20)
    animDot.Size = UDim2.new(0, 20, 0, 20)
    animDot.AnchorPoint = Vector2.new(0.5, 0.5)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = animDot

    local move = TweenService:Create(animDot, TweenInfo.new(0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
        Position = lastMainFramePos + UDim2.new(0, 240, 0, 165)
    })
    move:Play()
    move.Completed:Wait()

    local expand = TweenService:Create(animDot, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 480, 0, 330)
    })
    local squareCorner = TweenService:Create(corner, TweenInfo.new(0.2), {
        CornerRadius = UDim.new(0, 10)
    })

    expand:Play()
    squareCorner:Play()
    expand.Completed:Wait()

    animDot:Destroy()
    MainFrame.Position = lastMainFramePos
    MainFrame.Visible = true
end

---------------------------------------------------------
-- 6. CUSTOM DRAGGING
---------------------------------------------------------
local dragging = false
local dragInput, dragStart, startPos

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        TweenService:Create(MainFrame, TweenInfo.new(0.15), {BackgroundTransparency = 0.55}):Play()
        TweenService:Create(TopBar, TweenInfo.new(0.15), {BackgroundTransparency = 0.55}):Play()
        TweenService:Create(EditorFrame, TweenInfo.new(0.15), {BackgroundTransparency = 0.55}):Play()

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                TweenService:Create(MainFrame, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
                TweenService:Create(TopBar, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
                TweenService:Create(EditorFrame, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

