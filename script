local function updateEditor()
    local text = ScriptInput.Text
    local _, lineCount = string.gsub(text, "\n", "\n")
    lineCount = lineCount + 1

    local linesText = ""
    for i = 1, lineCount do
        linesText = linesText .. tostring(i) .. "\n"
    end
    LineNumbers.Text = linesText

    local newHeight = math.max(178, lineCount * 16)
    EditorFrame.CanvasSize = UDim2.new(0, 0, 0, newHeight)
    ScriptInput.Size = UDim2.new(1, -45, 0, newHeight)
    LineNumbers.Size = UDim2.new(0, 35, 0, newHeight)
end

ScriptInput:GetPropertyChangedSignal("Text"):Connect(updateEditor)

