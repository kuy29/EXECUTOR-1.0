-- [UPDATED] ปุ่ม Run สคริปต์ พร้อมระบบตรวจจับ Error / Empty
RunBtn.MouseButton1Click:Connect(function()
    local code = ScriptInput.Text
    if string.gsub(code, "%s+", "") == "" then
        showNotification("⚠️ PLEASE ENTER A SCRIPT FIRST", false, true)
        return
    end

    local success, err = pcall(function()
        loadstring(code)()
    end)

    if success then
        showNotification("✅ RUN SUCCESSFUL!", true, false)
    else
        showNotification("❌ RUN FAILED: " .. tostring(err), false, false)
    end
end)

-- [UPDATED] ปุ่ม Copy สคริปต์ พร้อมระบบเช็กความว่างเปล่า
CopyBtn.MouseButton1Click:Connect(function()
    local code = ScriptInput.Text
    if string.gsub(code, "%s+", "") == "" then
        showNotification("⚠️ NOTHING TO COPY!", false, true)
        return
    end

    if setclipboard then
        setclipboard(code)
        showNotification("📋 COPIED TO CLIPBOARD!", true, false)
    else
        showNotification("❌ EXECUTOR DOES NOT SUPPORT SETCLIPBOARD", false, false)
    end
end)

ClearBtn.MouseButton1Click:Connect(function()
    ScriptInput.Text = ""
    updateEditor()
    showNotification("🗑️ CLEARED ALL TEXT", true, false)
end)

MinimizeBtn.MouseButton1Click:Connect(closeToToggleAnim)
OpenToggleBtn.MouseButton1Click:Connect(openFromToggleAnim)

task.spawn(playStartupAnimation)
